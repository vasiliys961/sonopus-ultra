# OpenRouter-совместимый провайдер. Без ключа захват и Quality Gate работают,
# а диагностический разбор возвращает outcome: error и не выдумывает диагноз.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BRAIN1_MODEL=google/gemini-3.8
BRAIN2_MODEL=anthropic/claude-sonnet

# Необязательная отправка уже подтверждённого врачом результата.
DOCTOR_OPUS_FORWARD_URL=

# Папка, куда аппарат складывает DICOM. Пусто — кнопка в кабинете сообщит, что папка не настроена.
DICOM_HOTFOLDER=

# heuristic | ml. ml без зарегистрированных весов не подменяет эвристику и отказывается считать.
SONO_QUALITY_SCORER=heuristic

# Модель слоя зрения. Пустой ключ OpenRouter — слой работает локально и орган не выдумывает.
VISION_MODEL=google/gemini-3.8-flash
